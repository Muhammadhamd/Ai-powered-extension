{
    "manifest_version": 3,
    "name": "BrowBuddy",
    "version": "1.0",
    "description": "AI-powered browser assistant that helps you navigate and interact with web content.",
    "permissions": [
        "scripting", 
        "activeTab", 
        "storage",
        "tabs",
        "history"
    ],

    "action": {
        "default_popup": "popup.html",
        "default_title": "BrowBuddy AI Assistant"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js", "agentFlow.js","tools.js"],
            "css": ["content.css"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "popup.html", 
                "popup.js", 
                "popup.css"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}